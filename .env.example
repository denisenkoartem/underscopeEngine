# Server only (Vercel project settings in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# All AI calls use OpenAI at request time (photo grading, photo classification, fault-code explanations)
OPENAI_API_KEY=
OPENAI_MODEL=
# Stage 1 of photo grading (api/classify-photos): photo views + crop boxes. Defaults to gpt-4o-mini
OPENAI_CLASSIFY_MODEL=
# Fault-code explanations (api/decode-codes). Defaults to OPENAI_MODEL
OPENAI_CODES_MODEL=

# Front end (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# packages/engine (TypeScript ACV-vs-Copart engine) reads OPENAI_API_KEY above;
# ANTHROPIC_API_KEY is optional, for its market-fit call
ANTHROPIC_API_KEY=
