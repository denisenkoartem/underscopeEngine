{
  "$defs": {
    "Condition": {
      "description": "What the seller's description says beyond the damage itself (the reader's Assessment).\nNone means not stated: the simulation then runs the fact as a chance of its bad value\ninstead of guessing (config `condition`).",
      "properties": {
        "airbags_deployed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Airbags Deployed"
        },
        "catalytic_converter": {
          "anyOf": [
            {
              "enum": [
                "present",
                "missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalytic Converter"
        },
        "engine": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "minor",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "fire_damage": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fire Damage"
        },
        "flood_suspected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flood Suspected"
        },
        "keys": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "lien": {
          "anyOf": [
            {
              "enum": [
                "none",
                "open"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lien"
        },
        "odometer_status": {
          "anyOf": [
            {
              "enum": [
                "actual",
                "not_actual",
                "exempt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Odometer Status"
        },
        "run_status": {
          "anyOf": [
            {
              "enum": [
                "runs_and_drives",
                "starts",
                "does_not_start"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Status"
        },
        "title_in_hand": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title In Hand"
        },
        "transmission": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "minor",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transmission"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "DamageFinding": {
      "properties": {
        "box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "damage_type": {
          "$ref": "#/$defs/DamageType"
        },
        "panel": {
          "$ref": "#/$defs/Panel"
        },
        "photo_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Photo Ref"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "center"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "panel",
        "damage_type",
        "severity",
        "confidence"
      ],
      "title": "DamageFinding",
      "type": "object"
    },
    "DamageType": {
      "enum": [
        "dent",
        "scratch",
        "crack",
        "crush",
        "broken"
      ],
      "title": "DamageType",
      "type": "string"
    },
    "Panel": {
      "enum": [
        "front_bumper",
        "rear_bumper",
        "hood",
        "fender",
        "door",
        "quarter_panel",
        "roof",
        "windshield",
        "frame"
      ],
      "title": "Panel",
      "type": "string"
    },
    "TitleStatus": {
      "enum": [
        "clean",
        "salvage",
        "rebuilt"
      ],
      "title": "TitleStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Input to evaluate and batch: one vehicle. Money in integer cents; photo refs are paths relative to --photo-root.",
  "properties": {
    "clean_value_cents": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clean Value Cents"
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine_audio_abnormal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Audio Abnormal"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DamageFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "insurance_claim": {
      "default": false,
      "title": "Insurance Claim",
      "type": "boolean"
    },
    "make": {
      "title": "Make",
      "type": "string"
    },
    "mechanical_repair_cents": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mechanical Repair Cents"
    },
    "mileage": {
      "minimum": 0,
      "title": "Mileage",
      "type": "integer"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "photo_refs": {
      "items": {
        "type": "string"
      },
      "title": "Photo Refs",
      "type": "array"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "repair_override_cents": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Override Cents"
    },
    "salvage_comps_cents": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Salvage Comps Cents"
    },
    "title_status": {
      "$ref": "#/$defs/TitleStatus",
      "default": "clean"
    },
    "trim": {
      "default": "",
      "title": "Trim",
      "type": "string"
    },
    "undercarriage_damage": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Undercarriage Damage"
    },
    "vin": {
      "title": "Vin",
      "type": "string"
    },
    "year": {
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "vin",
    "year",
    "make",
    "model",
    "mileage",
    "region"
  ],
  "title": "Vehicle",
  "type": "object"
}
