{
  "name": "underscope",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false scripts/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r test",
    "engine": "pnpm --filter @underscope/reader engine",
    "test:reader": "pnpm --filter @underscope/reader test",
    "typecheck:reader": "pnpm --filter @underscope/reader typecheck",
    "test:samples": "tsx scripts/test-samples.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
